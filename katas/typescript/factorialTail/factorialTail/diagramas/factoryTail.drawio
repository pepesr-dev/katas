        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Calcula la cantidad de ceros al final del factorial de un número\n\nskinparam backgroundColor #1E2024\nskinparam defaultFontName Arial\nskinparam shadowing false\n\nskinparam activity {\n  BackgroundColor #282C34\n  BorderColor #E5E9F0\n  FontColor #F8F9FA\n  DiamondBackgroundColor #282C34\n  DiamondBorderColor #E5E9F0\n  DiamondFontColor #F8F9FA\n}\n\nskinparam note {\n  BackgroundColor #23272E\n  BorderColor #61AFEF\n  FontColor #E5E9F0\n}\n\nskinparam arrow {\n  Color #D8DEE9\n  FontColor #98C379\n}\n\nstart\n\n:Inputs:\nbase (entero 2..256)\nnum (entero 1..1&#39;000&#39;000);\n\nif (¿base y num enteros\\nválidos en rango?) then (no)\n  :return \&quot;Error: base debe ser un entero entre 2 y 256\\ny num un entero entre 1 y 1&#39;000&#39;000\&quot;;\n  stop\nelse (sí)\nendif\n\n:1. Factorizar base en primos\n(ej. 12 -&gt; [2, 2, 3]);\n\n:minCeros = num;\n\nwhile (¿Quedan primos\\npor revisar?) is (sí)\n  :2. Contar veces del primo p en num!\n  (divisiones sucesivas con Math.floor);\n\n  :cerosPosibles = Math.floor(totalPrimo / repeticionesEnBase);\n\n  if (¿cerosPosibles &lt; minCeros?) then (sí)\n    :minCeros = cerosPosibles;\n  else (no)\n  endif\nendwhile (no)\n\n:return minCeros;\n\nstop\n\nfloating note right\n  **REGLA GENERAL (BASE B)**\n  B = p1^e1 * p2^e2 * ... * pk^ek\n\n  **FÓRMULA**\n  ceros = min( floor( vp(num!) / e ) )\n\n  **Ejemplos de salida:**\n  zeroes(10, 25)  -&gt; 6\n  zeroes(10, 100) -&gt; 24\n  zeroes(16, 32)  -&gt; 7\n  zeroes(12, 10)  -&gt; 4\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="BJA3XjenNdOjLVi5Szzz-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
